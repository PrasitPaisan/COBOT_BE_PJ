PLC_HOST=192.168.3.250
PLC_PORT=4999

MIN_TRAY_NO=1
MAX_TRAY_NO=8

SELECT_TRAY_BIT=D420
QUANTITY_DEVICE=D421
START_DEVICE=M283
RUNNING_DEVICE=M286
READY_DEVICE=M287

MANUAL_MODE_DEVICE=M0
AUTO_MODE_DEVICE=M1

HOLD_SECONDS=2
MODEL_NAME_WORDS=10

TASK_POLL_SECONDS=2
TASK_TIMEOUT_SECONDS=60

DATABASE_URL=postgresql+psycopg2://mcprotocol:mcprotocol@localhost:5432/mcprotocol

# URL the main system exposes to receive task-completion callbacks. Leave blank to disable
# (notify becomes a no-op) until the main system defines this endpoint's spec.
MAIN_SYSTEM_CALLBACK_URL=

# Camera frames arrive via POST /camera/ingest, pushed by the LAN-side camera_service
# (see camera_service/README or .env.example there). This token must match
# camera_service's CLOUD_INGEST_TOKEN.
CAMERA_INGEST_TOKEN=change-me
CAMERA_STREAM_IDLE_TIMEOUT_SECONDS=10

# Vision inspection handshake with the PLC (manual OK/NG for now, classifier later)
CAM_TRIG_DEVICE=M370
CAM_RESULT_OK_DEVICE=M372
CAM_RESULT_NG_DEVICE=M373
